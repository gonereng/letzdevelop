---
import { site } from "../content/site";
---

<header class="site-header">
  <div class="wrap flex items-center justify-between gap-4 py-3 md:py-4">
    <a class="mark text-xl md:text-2xl" href="/">
      <span class="mark-letz">Letz</span>Develop
    </a>

    <nav class="hidden md:block" aria-label="Hauptmenü">
      <ul class="flex items-center gap-6 text-[0.98rem]">
        {
          site.nav.map((item) => (
            <li>
              <a
                class="text-ink no-underline decoration-red decoration-2 underline-offset-8 hover:underline"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="cta cta-primary text-sm" href="/#vorschau">Vorschau anfragen</a>
        </li>
      </ul>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="list-none cursor-pointer rounded-full border border-ink px-4 py-2 text-sm font-semibold"
      >
        Menü
      </summary>
      <nav
        class="absolute right-0 mt-2 w-56 rounded-xl border border-stone bg-cream p-3 shadow-sm"
        aria-label="Mobil"
      >
        <ul class="flex flex-col gap-1">
          {
            site.nav.map((item) => (
              <li>
                <a class="block rounded-lg px-3 py-2 no-underline hover:bg-chip" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="cta cta-primary mt-2 w-full text-sm" href="/#vorschau">Vorschau anfragen</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
