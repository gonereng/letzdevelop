---
import { site } from "../content/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-stone bg-ink text-paper">
  <div class="wrap grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="mark text-2xl text-paper">
        <span class="mark-letz">Letz</span>Develop
      </p>
      <p class="mt-3 max-w-sm text-stone">
        Websites für Betriebe in Luxemburg. Klare Pakete, monatliches Hosting als Zusatz,
        unverbindliche Vorschau.
      </p>
      <p class="mt-4">
        <a class="text-paper underline decoration-red underline-offset-4" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </p>
    </div>

    <nav aria-label="Seite">
      <p class="mb-3 text-xs font-semibold tracking-[0.14em] uppercase text-stone">Seite</p>
      <ul class="space-y-2">
        {
          site.nav.map((item) => (
            <li>
              <a class="text-paper no-underline hover:underline" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Rechtliches">
      <p class="mb-3 text-xs font-semibold tracking-[0.14em] uppercase text-stone">Rechtliches</p>
      <ul class="space-y-2">
        <li><a class="text-paper no-underline hover:underline" href="/impressum">Impressum</a></li>
        <li><a class="text-paper no-underline hover:underline" href="/datenschutz">Datenschutz</a></li>
        <li><a class="text-paper no-underline hover:underline" href="/agb">AGB</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap border-t border-white/15 py-5 text-sm text-stone">
    <p>© {year} {site.name} · {site.domain}</p>
  </div>
</footer>
