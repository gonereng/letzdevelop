---
import { formatFromPrice, formatHostingMonthly } from "../lib/money";
import { site } from "../content/site";

interface Props {
  pkg: (typeof site.packages)[number];
}

const { pkg } = Astro.props;
---

<article
  class:list={[
    "flex h-full flex-col rounded-2xl border bg-cream p-6 md:p-8",
    pkg.featured ? "border-red shadow-[0_0_0_1px_var(--color-red)]" : "border-stone",
  ]}
>
  {
    pkg.featured && (
      <p class="mb-3 text-xs font-semibold tracking-[0.14em] uppercase text-red">Empfohlen</p>
    )
  }
  <h3 class="text-3xl">{pkg.name}</h3>
  <p class="mt-2 text-muted">{pkg.summary}</p>
  <p class="mt-6 font-display text-4xl">{formatFromPrice(pkg.priceEuro)}</p>
  <ul class="mt-6 mb-8 flex-1 space-y-2 text-muted">
    {pkg.features.map((feature) => <li>{feature}</li>)}
  </ul>
  <p class="mt-auto -mx-6 -mb-6 md:-mx-8 md:-mb-8 rounded-b-2xl border-t border-stone bg-chip px-6 py-4 text-sm font-semibold md:px-8">
    {formatHostingMonthly(site.hosting.monthlyEuro)}
  </p>
</article>
