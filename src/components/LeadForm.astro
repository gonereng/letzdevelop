---
import { site } from "../content/site";
import { formspreeAction } from "../lib/form";

interface Props {
  variant: "vorschau" | "kontakt";
}

const { variant } = Astro.props;
const action = formspreeAction(import.meta.env.PUBLIC_FORMSPREE_ID);
const sent = Astro.url.searchParams.get("gesendet") === variant;
const next = `${Astro.url.origin}/?gesendet=${variant}#${variant === "vorschau" ? "vorschau" : "kontakt"}`;
const mailto =
  variant === "vorschau"
    ? `mailto:${site.email}?subject=${encodeURIComponent("Unverbindliche Redesign-Vorschau")}`
    : `mailto:${site.email}?subject=${encodeURIComponent("Anfrage LetzDevelop")}`;
---

{
  sent ? (
    <div class="rounded-2xl border border-moss bg-cream p-6" role="status">
      {variant === "vorschau" ? (
        <p>
          Danke. Wir melden uns in der Regel innerhalb von {site.turnaroundDays} Werktagen mit einer
          Richtung. Die Vorschau bleibt <strong>unverbindlich</strong> – daraus entsteht{" "}
          <strong>keine Kaufverpflichtung</strong>.
        </p>
      ) : (
        <p>Danke für Ihre Nachricht. Wir antworten an die angegebene Adresse.</p>
      )}
    </div>
  ) : action ? (
    <form class="grid gap-4" action={action} method="POST">
      <input type="hidden" name="_subject" value={variant === "vorschau" ? "Vorschau-Anfrage" : "Kontaktanfrage"} />
      <input type="hidden" name="_next" value={next} />
      <input type="hidden" name="formular" value={variant} />
      <p class="hp">
        <label>
          Nicht ausfüllen
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <div class="field">
        <label for={`${variant}-name`}>Name</label>
        <input id={`${variant}-name`} name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for={`${variant}-email`}>E-Mail</label>
        <input id={`${variant}-email`} name="email" type="email" autocomplete="email" required />
      </div>

      {variant === "vorschau" ? (
        <div class="field">
          <label for="vorschau-url">Aktuelle Website</label>
          <input
            id="vorschau-url"
            name="website"
            type="url"
            inputmode="url"
            autocomplete="url"
            placeholder="https://"
            required
          />
        </div>
      ) : (
        <>
          <div class="field">
            <label for="kontakt-tel">Telefon <span class="font-normal text-muted">(optional)</span></label>
            <input id="kontakt-tel" name="telefon" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="kontakt-paket">Paket</label>
            <select id="kontakt-paket" name="paket">
              <option value="">Noch offen</option>
              {site.packages.map((pkg) => (
                <option value={pkg.id}>{pkg.name}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="kontakt-nachricht">Nachricht</label>
            <textarea id="kontakt-nachricht" name="nachricht" required />
          </div>
        </>
      )}

      {variant === "vorschau" ? (
        <label class="flex gap-3 text-sm items-start">
          <input class="mt-1" type="checkbox" name="einverstaendnis" value="ja" required />
          <span>
            Ich bin einverstanden, dass LetzDevelop mich zur <strong>unverbindlichen</strong> Vorschau
            kontaktiert. Es entsteht <strong>keine Kaufverpflichtung</strong>.
          </span>
        </label>
      ) : (
        <label class="flex gap-3 text-sm items-start">
          <input class="mt-1" type="checkbox" name="datenschutz" value="ja" required />
          <span>
            Ich habe die{" "}
            <a class="underline" href="/datenschutz">
              Datenschutzerklärung
            </a>{" "}
            gelesen und willige in die Verarbeitung meiner Angaben zur Beantwortung der Anfrage ein.
          </span>
        </label>
      )}

      <button class="cta cta-primary justify-self-start" type="submit">
        {variant === "vorschau" ? "Unverbindliche Vorschau anfragen" : "Nachricht senden"}
      </button>
    </form>
  ) : (
    <div class="grid gap-4">
      <p>
        {variant === "vorschau" ? (
          <>
            Schreiben Sie uns an {site.email} mit Ihrer Website-Adresse. Die Vorschau ist{" "}
            <strong>unverbindlich</strong> und begründet <strong>keine Kaufverpflichtung</strong>.
          </>
        ) : (
          <>Schreiben Sie uns an {site.email}. Wir antworten auf Deutsch.</>
        )}
      </p>
      <a class="cta cta-primary justify-self-start" href={mailto}>
        E-Mail an {site.email}
      </a>
    </div>
  )
}
