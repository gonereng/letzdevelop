---
import { site } from "../../content/site";
---

<section class="section" id="problem" aria-labelledby="problem-title">
  <div class="wrap">
    <p class="section-kicker">Warum jetzt</p>
    <h2 id="problem-title" class="text-3xl md:text-5xl max-w-3xl">
      Eine müde Website kostet Anfragen, bevor jemand anruft.
    </h2>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {
        site.problems.map((item) => (
          <article class="border-l-2 border-red pl-5">
            <h3 class="text-2xl">{item.title}</h3>
            <p class="mt-3 text-muted">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
