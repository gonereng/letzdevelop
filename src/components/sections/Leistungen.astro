---
import { site } from "../../content/site";
---

<section class="section pt-0" id="leistungen" aria-labelledby="leistungen-title">
  <div class="wrap">
    <p class="section-kicker">Leistungen</p>
    <h2 id="leistungen-title" class="text-3xl md:text-5xl max-w-3xl">
      Was wir für Ihren Auftritt tun.
    </h2>
    <ul class="mt-12 grid gap-5 md:grid-cols-2" role="list">
      {
        site.services.map((item) => (
          <li class="rounded-2xl border border-stone bg-cream p-6 md:p-8">
            <h3 class="text-2xl">{item.title}</h3>
            <p class="mt-3 text-muted">{item.text}</p>
            <p class="mt-4">
              <a class="font-semibold underline decoration-red underline-offset-4" href={item.href}>
                {item.linkLabel}
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
