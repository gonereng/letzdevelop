---
import { site } from "../../content/site";
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="section-kicker">FAQ</p>
      <h2 id="faq-title" class="text-3xl md:text-5xl">Häufige Fragen, knapp beantwortet.</h2>
    </div>
    <div class="divide-y divide-stone border-y border-stone">
      {
        site.faq.map((item) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold pr-8 relative">
              {item.q}
              <span class="absolute right-0 top-0 text-red" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
