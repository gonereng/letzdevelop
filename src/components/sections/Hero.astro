---
import CtaButton from "../CtaButton.astro";
import { site } from "../../content/site";
import { formatFromPrice } from "../../lib/money";

const basic = site.packages.find((pkg) => pkg.id === "basic")!;
---

<section class="section" aria-labelledby="hero-title">
  <div class="wrap grid items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)]">
    <div>
      <p class="section-kicker">Luxemburg · Deutsch</p>
      <h1 id="hero-title" class="text-4xl md:text-6xl max-w-3xl">
        Die Website, die zu Ihrem Betrieb passt.
      </h1>
      <p class="lede mt-5">
        LetzDevelop gestaltet und betreibt Websites für Unternehmen in Luxemburg. Klare Paketpreise,
        Hosting als monatliches Zusatzmodul, unverbindliche Redesign-Vorschau in {site.turnaroundDays} Werktagen.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <CtaButton href="#vorschau">Unverbindliche Vorschau</CtaButton>
        <CtaButton href="#preise" variant="secondary">Pakete ansehen</CtaButton>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted" role="list">
        <li>Sitz in Luxemburg</li>
        <li>{formatFromPrice(basic.priceEuro)}</li>
        <li>Vorschau in {site.turnaroundDays} Werktagen</li>
      </ul>
    </div>

    <div class="browser" aria-hidden="true">
      <div class="browser-bar">
        <span></span><span></span><span></span>
        <p>ihre-firma.lu</p>
      </div>
      <div class="browser-body">
        <div class="h-3 w-1/3 rounded-full bg-red/80"></div>
        <div class="mt-4 h-8 w-4/5 rounded-sm bg-ink/90"></div>
        <div class="mt-3 space-y-2">
          <div class="h-2 w-full rounded-full bg-stone"></div>
          <div class="h-2 w-5/6 rounded-full bg-stone"></div>
          <div class="h-2 w-2/3 rounded-full bg-stone"></div>
        </div>
        <div class="mt-6 grid grid-cols-3 gap-3">
          <div class="h-16 rounded-md bg-chip"></div>
          <div class="h-16 rounded-md bg-chip"></div>
          <div class="h-16 rounded-md bg-chip"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .browser {
    border: 1px solid var(--color-stone);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--color-cream);
    box-shadow: 0 18px 40px -24px rgb(28 25 21 / 0.45);
    transform: rotate(-1.2deg);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.7rem 1rem;
    background: var(--color-chip);
    border-bottom: 1px solid var(--color-stone);
  }

  .browser-bar span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-stone);
  }

  .browser-bar p {
    margin-left: 0.6rem;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .browser-body {
    padding: 1.5rem;
    min-height: 16rem;
  }
</style>
